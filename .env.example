# --- Base de datos (servicio sidhe-postgres en Easypanel; local: docker-compose) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sidhe

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+5215638955164
# Desactivar SOLO en desarrollo local sin Twilio real
TWILIO_VALIDATE_SIGNATURE=true
# SID del Content Template de recordatorio aprobado por WhatsApp
# (créalo con: uv run python scripts/setup_recordatorio_template.py)
TWILIO_RECORDATORIO_CONTENT_SID=
# URL pública del servicio (necesaria detrás de proxy para validar la firma de Twilio)
PUBLIC_BASE_URL=

# --- Transcripción de voz ---
GROQ_API_KEY=
# Fallback si GROQ_API_KEY no está definida (también usado por embeddings openai)
OPENAI_API_KEY=

# --- Embeddings para RAG ---
# voyage | cohere | openai | bge-m3 (stub self-hosted)
EMBEDDINGS_PROVIDER=openai
# Vacío = default del proveedor (voyage-3.5 / embed-multilingual-v3.0 / text-embedding-3-small)
EMBEDDINGS_MODEL=
VOYAGE_API_KEY=
COHERE_API_KEY=
# Solo para el stub bge-m3 self-hosted
EMBEDDINGS_BASE_URL=

# --- API interna (recordatorios, disparada desde n8n) ---
INTERNAL_API_KEY=

# --- Google Calendar (espejo de citas por sucursal) ---
# Contenido COMPLETO del JSON de la cuenta de servicio. Vacio = desactivado.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CALENDAR_RECORDATORIO_MIN=60

# --- n8n (push de citas a Google Sheets) ---
N8N_WEBHOOK_CITAS=

# --- Sistema ---
TZ=America/Mexico_City
LOG_LEVEL=INFO
